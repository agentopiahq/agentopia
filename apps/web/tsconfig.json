{
  "extends": "@agentopia/typescript-config/nextjs.json",
  "compilerOptions": {
    "target": "ES2022",
    "paths": {
      "@/*": ["./src/*"],
      "@tests/*": ["./tests/*"]
    },
    "types": ["node", "jest"]
  },
  "include": [
    "next-env.d.ts",
    "next.config.js",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "jest.config.cjs",
    "jest.setup.ts",
    "postcss.config.mjs",
    "tailwind.config.cjs"
  ],
  "exclude": ["node_modules"]
}
