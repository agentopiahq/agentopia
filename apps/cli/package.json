{
  "name": "@agentopia/cli",
  "version": "0.0.0",
  "description": "Watch your coding agent work as an animated office of little clones.",
  "keywords": [
    "claude-code",
    "coding-agent",
    "hooks",
    "visualization",
    "office"
  ],
  "homepage": "https://agentopia.town",
  "bugs": {
    "url": "https://github.com/tuliren/agentopia/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tuliren/agentopia.git",
    "directory": "apps/cli"
  },
  "license": "MIT",
  "author": "Liren Tu",
  "exports": {
    ".": "./dist/agentopia.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "agentopia": "./dist/agentopia.mjs"
  },
  "files": [
    "dist/agentopia.mjs",
    "viewer",
    "!viewer/**/*.map",
    "plugins"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint . --max-warnings 0",
    "prepack": "node scripts/stage.mjs",
    "postpack": "node scripts/stage.mjs clean",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit --p tsconfig.json"
  },
  "devDependencies": {
    "@agentopia/core": "*",
    "@agentopia/eslint-config": "*",
    "@agentopia/jest-presets": "*",
    "@agentopia/typescript-config": "*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
