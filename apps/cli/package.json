{
  "name": "@repo/cli",
  "version": "0.0.1",
  "private": true,
  "bin": {
    "cubicle": "./dist/cubicle.mjs"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/cubicle.mjs --banner:js='#!/usr/bin/env node'",
    "lint": "eslint . --max-warnings 0",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit --p tsconfig.json"
  },
  "dependencies": {
    "@repo/core": "*"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/jest-presets": "*",
    "@repo/typescript-config": "*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.9.3"
  }
}
