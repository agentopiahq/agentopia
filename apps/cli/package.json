{
  "name": "@agentopia/cli",
  "version": "0.0.1",
  "private": true,
  "bin": {
    "agentopia": "./dist/agentopia.mjs"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/agentopia.mjs --banner:js='#!/usr/bin/env node'",
    "lint": "eslint . --max-warnings 0",
    "test": "jest --coverage",
    "typecheck": "tsc --noEmit --p tsconfig.json"
  },
  "dependencies": {
    "@agentopia/core": "*"
  },
  "devDependencies": {
    "@agentopia/eslint-config": "*",
    "@agentopia/jest-presets": "*",
    "@agentopia/typescript-config": "*",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "typescript": "^6.0.3"
  }
}
