{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env.*local"],
  "globalEnv": [
    "CUBICLE_BUS",
    "CUBICLE_HOME",
    "CUBICLE_NO_AUTORUN",
    "CUBICLE_NO_OPEN",
    "CUBICLE_NO_SERVER",
    "CUBICLE_PLUGINS_DIR",
    "CUBICLE_PORT",
    "CUBICLE_SESSION",
    "CUBICLE_VIEWER_DIR",
    "FORCE_COLOR",
    "NEXT_PUBLIC_VERCEL_ENV",
    "NODE_ENV",
    "NO_COLOR",
    "SCRIPT_ENV"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.stories.{ts,tsx,jsx,mdx}"],
      "outputs": [".next/**", "!.next/cache/**", "storybook-static/**", "dist/**"]
    },
    "format:check": {
      "cache": false
    },
    "format:write": {
      "cache": false
    }
  }
}
