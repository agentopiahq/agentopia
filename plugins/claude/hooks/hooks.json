{
  "description": "cubicle - mirrors session lifecycle events onto the office event bus",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/emit.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
