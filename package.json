{
  "name": "agentopia-town",
  "private": true,
  "description": "Watch your coding agent work as an animated office of little clones.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "agentopia": "turbo build --filter=@agentopia/cli --filter=@agentopia/viewer --output-logs=errors-only && node apps/cli/dist/agentopia.mjs",
    "build": "turbo build",
    "dev": "turbo dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json}\" --log-level=warn",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\" --log-level=warn",
    "postinstall": "husky",
    "lint": "turbo lint",
    "prepare": "husky",
    "replay": "turbo build --filter=@agentopia/cli --filter=@agentopia/viewer --output-logs=errors-only && node scripts/replay-fixture.mjs",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,mdx}": "yarn prettier --write"
  },
  "resolutions": {
    "glob@^10.4.1": "^14.0.6",
    "glob@^10.5.0": "^14.0.6",
    "glob@^13.0.6": "^14.0.6",
    "minimatch@^10.2.2": "^11.0.8",
    "minimatch@^9.0.0": "^11.0.8",
    "minimatch@^9.0.4": "^11.0.8",
    "postcss-selector-parser@6.0.10": "^6.1.6",
    "uuid@^8.3.2": "11.1.1",
    "webpack-dev-middleware@^6.1.2": "^7.4.6"
  },
  "devDependencies": {
    "@agentopia/eslint-config": "*",
    "@agentopia/typescript-config": "*",
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.10.1",
    "prettier-plugin-packagejson": "^3.1.0",
    "turbo": "^2.11.11"
  },
  "packageManager": "yarn@4.9.1",
  "engines": {
    "node": ">=20"
  }
}
