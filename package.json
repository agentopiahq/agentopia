{
  "name": "cubicle-town",
  "private": true,
  "description": "Watch your coding agent work as an animated office of little clones.",
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "cubicle": "turbo build --filter=@cubicle/cli --output-logs=errors-only && node apps/cli/dist/cubicle.mjs",
    "dev": "turbo dev",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json}\" --log-level=warn",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,json}\" --log-level=warn",
    "postinstall": "husky",
    "lint": "turbo lint",
    "prepare": "husky",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,mdx}": "yarn prettier --write"
  },
  "resolutions": {
    "uuid@^8.3.2": "11.1.1"
  },
  "devDependencies": {
    "@cubicle/eslint-config": "*",
    "@cubicle/typescript-config": "*",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-packagejson": "^3.0.2",
    "turbo": "^2.10.11"
  },
  "packageManager": "yarn@4.9.1",
  "engines": {
    "node": ">=20"
  }
}
